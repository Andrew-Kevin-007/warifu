# services/kernel — ALL secrets live here and only here. Never commit a filled .env.
NODE_ENV=development
NETWORK=testnet                 # testnet | mainnet | local
ARC_RPC_URL=                    # Canteen-hosted testnet RPC: `arc-canteen rpc`
ARC_MAINNET_RPC_URL=            # V-03: verify before use
# Circle (separate keys for testnet vs mainnet)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET   # mainnet value: V-03
RELAYER_WALLET_ID=
RELAYER_WALLET_ADDRESS=
CIRCLE_WEBHOOK_PUBLIC_KEY_ID=   # V-12
# Keys (secp256k1). Disclose kernel-signer custody in the README.
KERNEL_SIGNER_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
# web -> kernel auth (HMAC)
SERVICE_TOKEN_SECRET=
# Data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: CI evidence reads
GITHUB_TOKEN=
