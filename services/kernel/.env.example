# services/kernel — ALL secrets live here and only here. Never commit a filled .env.
NODE_ENV=development
NETWORK=testnet                 # testnet | mainnet | local
ARC_RPC_URL=                    # Canteen-hosted testnet RPC: `arc-canteen rpc`
# Mainnet (production profile only; docs/DEPLOY_MAINNET.md). Take both values from the Arc docs' network page; the kernel
# compares the chain id with the live node at boot and refuses to start on a mismatch. ARC_RPC_URL must be unset on mainnet.
ARC_MAINNET_CHAIN_ID=           # V-03: operator-supplied, never defaulted
ARC_MAINNET_RPC_URL=            # https only
# Circle (separate keys for testnet vs mainnet)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET   # mainnet: Circle's Arc mainnet identifier, set explicitly (V-03); never ARC-TESTNET
RELAYER_WALLET_ID=
RELAYER_WALLET_ADDRESS=
CIRCLE_WEBHOOK_PUBLIC_KEY_ID=   # V-12; comma-separated key ids the webhook accepts (empty = it refuses everything)
# Keys (secp256k1). Disclose kernel-signer custody in the README.
KERNEL_SIGNER_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
# web -> kernel auth (HMAC)
SERVICE_TOKEN_SECRET=
# Data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: CI evidence reads
GITHUB_TOKEN=

# --- WP-10 additions -------------------------------------------------------------------------------------------------
# Profile (required, no default): production | sandbox. A sandbox env must contain NO PROD_*/MAINNET_* variable except the two denylists.
KERNEL_PROFILE=
EVIDENCE_MODE=live              # sandbox: fixtures
# Direct Postgres connection (service role). Any password must be >= 16 characters; every secret below must be >= 16 characters.
DATABASE_URL=
BLOB_DIR=                       # opaque document blobs, stored under their SHA-256 and never parsed (production only)
MAX_JSON_BYTES=                 # default 262144
MAX_BLOB_BYTES=                 # default 10485760 (the sandbox accepts no blob)
PORT=8787
HOST=127.0.0.1
# sandbox only (docs/15 section 3)
PROD_SIGNER_ADDRESSES=
PROD_SUPABASE_HOST=
CHALLENGE_ENABLED=
CHALLENGE_LLM_DAILY_BUDGET_USD=
CHALLENGE_IP_SALT=
ANTHROPIC_API_KEY=

# --- WP-12 additions -------------------------------------------------------------------------------------------------
INDEXER_ENABLED=                # default true; the vault event indexer (docs/05 section 6)
INDEXER_CONFIRMATIONS=          # default 2: blocks behind the head before a log is applied (VERIFY V-24: Arc finality)
INDEXER_POLL_MS=                # default 5000
INDEXER_START_BLOCK=            # the vault deployment block (default 0)
# Optional throwaway-key relayer for local/testnet ONLY (>= 16 characters; must differ from the kernel signer key).
# Unset = signatures are collected but nothing is submitted. Mutually exclusive with the Circle relayer (CIRCLE_API_KEY + CIRCLE_ENTITY_SECRET + RELAYER_WALLET_ID + RELAYER_WALLET_ADDRESS).
RELAYER_PRIVATE_KEY=

# --- WP-13 additions -------------------------------------------------------------------------------------------------
# Production live evidence only (ignored by the sandbox, which has no evidence network path at all; EVIDENCE_MODE=fixtures).
EVIDENCE_EGRESS_PROXY=          # optional host:port of the deny-by-default egress proxy (HTTP CONNECT to the pinned IP:443)
MAX_ARTIFACT_BYTES=             # default 5242880: largest file the kernel hashes for ARTIFACT_HASH evidence
