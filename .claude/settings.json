{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm verify)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:web-env)",
      "Bash(pnpm claude:check)",
      "Bash(pnpm claims:lint)",
      "Bash(pnpm sec:local)",
      "Bash(forge build)",
      "Bash(forge test)",
      "Bash(forge test --match-*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git diff)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(pnpm dlx*)",
      "Bash(pnpx *)",
      "Bash(npx *)",
      "Bash(*--ffi*)",
      "Bash(git difftool*)",
      "Bash(git diff*--ext-diff*)",
      "Bash(git diff*--no-index*)",
      "Bash(git diff*--output*)",
      "Bash(git add*-f*)",
      "Bash(git add*--force*)",
      "Bash(*--no-verify*)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(**/scripts/git-hooks/**)",
      "Write(**/scripts/git-hooks/**)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest*)",
      "Bash(iwr *)",
      "Bash(git push*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.sandbox)",
      "Read(**/.env.development.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
