                  "required": [
                    "type",
                    "url",
                    "expectStatus"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "ARTIFACT_HASH"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "type",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "EVIDENCE_OK",
              "PAID",
              "DISPUTED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "milestoneId",
          "slug",
          "description",
          "amountBaseUnits",
          "partialAllowed",
          "immediate",
          "dueDate",
          "category",
          "evidenceSpec",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "netDays": {
          "type": "integer",
