            "alwaysHuman": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "reserve": {
          "type": "object",
          "properties": {
            "floor": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})(\\.[0-9]{1,36})?$"
            },
            "lookaheadDays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
