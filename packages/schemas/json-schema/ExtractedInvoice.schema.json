{
  "$id": "https://symbolon.dev/schemas/v1/ExtractedInvoice.schema.json",
  "title": "ExtractedInvoice",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "docType": {
      "type": "string",
      "enum": [
        "INVOICE",
        "CREDIT_NOTE",
        "STATEMENT",
        "OTHER"
      ]
    },
    "invoiceNumber": {
      "type": "string",
      "maxLength": 128
    },
    "issueDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dueDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payee": {
      "type": "object",
      "properties": {
        "legalName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "walletAddress": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimsAddressChange": {
          "type": "boolean"
        }
      },
      "required": [
        "legalName",
        "walletAddress",
        "claimsAddressChange"
      ],
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "properties": {
        "printed": {
          "type": "string",
          "maxLength": 64
        },
        "currencyPrinted": {
          "type": "string",
          "maxLength": 32
        },
        "decimalSeparatorGuess": {
          "type": "string",
          "enum": [
            ".",
            ",",
            "none",
            "ambiguous"
          ]
        },
        "parsedBaseUnits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,29})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "printed",
        "currencyPrinted",
        "decimalSeparatorGuess",
        "parsedBaseUnits",
        "decimals"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "engagementId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "milestoneId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "poNumber": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "engagementId",
        "milestoneId",
        "poNumber"
      ],
      "additionalProperties": false
    },
    "statedTerms": {
      "type": "object",
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "netDays": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            },
            {
              "type": "null"
            }
          ]
        },
        "earlyPay": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "discountBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "withinDays": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3650
                }
              },
              "required": [
                "discountBps",
                "withinDays"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguous": {
          "type": "boolean"
        }
      },
      "required": [
        "raw",
        "netDays",
        "earlyPay",
        "ambiguous"
      ],
      "additionalProperties": false
    },
    "lineItems": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "amountPrinted": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "description",
          "amountPrinted"
        ],
        "additionalProperties": false
      }
    },
    "anomalies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INSTRUCTION_IN_DOC",
              "ADDRESS_CHANGE",
              "AMOUNT_AMBIGUOUS",
              "MISSING_FIELD",
              "HIDDEN_CHARS",
              "TERMS_CLAIM",
              "OTHER"
            ]
          },
          "quote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "docType",
    "invoiceNumber",
    "issueDate",
    "dueDate",
    "payee",
    "amount",
    "references",
    "statedTerms",
    "lineItems",
    "anomalies",
    "confidence"
  ],
  "additionalProperties": false
}
